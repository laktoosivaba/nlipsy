  "input": "{\n  \"MessageType\": \"Request\",\n  \"Format\": \"text\",\n  \"Subformat\": \"English\",\n  \"Content\": \"What is Ecma?\",\n  \"Submessages\": [\n    {\n      \"Label\": \"role\",\n      \"Format\": \"text\",\n      \"Subformat\": \"English\",\n      \"Content\": \"user\"\n    }\n  ]\n}",
